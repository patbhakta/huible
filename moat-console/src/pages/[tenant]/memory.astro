---
import Console from "../../layouts/Console.astro";
import { searchConversations, searchMemories } from "../../lib/gateway";
import { clampLimit, notFound, tenantFromParams } from "../../lib/page";

const tenant = tenantFromParams(Astro.params.tenant);
if (!tenant) return notFound(`Unknown tenant "${Astro.params.tenant ?? ""}".`);

const q0 = (Astro.url.searchParams.get("q0") ?? "").trim();
const l0 = clampLimit(Astro.url.searchParams.get("l0"));
const q1 = (Astro.url.searchParams.get("q1") ?? "").trim();
const type1 = (Astro.url.searchParams.get("type1") ?? "").trim();
const l1 = clampLimit(Astro.url.searchParams.get("l1"));

type SearchOutcome =
  | { state: "idle" }
  | { state: "ok"; text: string; total: number; strategy?: string }
  | { state: "error"; message: string };

let l0Result: SearchOutcome = { state: "idle" };
let l1Result: SearchOutcome = { state: "idle" };

if (q0) {
  try {
    const r = await searchConversations(tenant, q0, { limit: l0 });
    l0Result = { state: "ok", text: r.results ?? "", total: r.total ?? 0 };
  } catch (err) {
    l0Result = { state: "error", message: err instanceof Error ? err.message : String(err) };
  }
}
if (q1) {
  try {
    const r = await searchMemories(tenant, q1, { limit: l1, type: type1 || undefined });
    l1Result = { state: "ok", text: r.results ?? "", total: r.total ?? 0, strategy: r.strategy };
  } catch (err) {
    l1Result = { state: "error", message: err instanceof Error ? err.message : String(err) };
  }
}
---

<Console title={`Memory — ${tenant.label}`} tenant={tenant}>
  <div class="page-head">
    <span class="kicker">Memory browser &middot; {tenant.label}</span>
    <h1>The Ledger of Conversations</h1>
    <p class="dim">
      L0 searches the session ledgers; L1 reads the durable profile memories. Results are shown
      exactly as the store returns them — tenant-scoped, cross-tenant rows dropped.
    </p>
  </div>

  <section>
    <h2 class="rule-head"><span class="numeral">I.</span> L0 — conversation search</h2>
    <div class="panel">
      <h3>Search the session ledgers</h3>
      <form class="controls" method="get" action={`/${tenant.slug}/memory`}>
        <label for="q0">query</label>
        <input type="text" id="q0" name="q0" value={q0} placeholder="e.g. thanksgiving plans" />
        <label for="l0">limit</label>
        <input type="text" id="l0" name="l0" value={q0 ? String(l0) : "20"} style="flex: 0 1 5rem;" />
        <button type="submit">Search L0</button>
      </form>
      {l0Result.state === "ok" && (
        <div style="margin-top: 1.1rem;">
          <div class="meta-line">
            <span>total <b>{l0Result.total}</b></span>
          </div>
          {l0Result.text ? <pre class="verbatim">{l0Result.text}</pre> : <p class="empty-note">No rows matched.</p>}
        </div>
      )}
      {l0Result.state === "error" && <p class="error-note" style="margin-top: 1.1rem;">L0 search failed — {l0Result.message}</p>}
    </div>
  </section>

  <section>
    <h2 class="rule-head"><span class="numeral">II.</span> L1 — profile memories</h2>
    <div class="panel">
      <h3>Search the durable profile</h3>
      <form class="controls" method="get" action={`/${tenant.slug}/memory`}>
        <label for="q1">query</label>
        <input type="text" id="q1" name="q1" value={q1} placeholder="e.g. keeps the apartment spotless" />
        <label for="type1">type</label>
        <input type="text" id="type1" name="type1" value={type1} placeholder="optional" style="flex: 0 1 8rem;" />
        <label for="l1">limit</label>
        <input type="text" id="l1" name="l1" value={q1 ? String(l1) : "20"} style="flex: 0 1 5rem;" />
        <button type="submit">Search L1</button>
      </form>
      {l1Result.state === "ok" && (
        <div style="margin-top: 1.1rem;">
          <div class="meta-line">
            <span>total <b>{l1Result.total}</b></span>
            {l1Result.strategy && <span>strategy <b>{l1Result.strategy}</b></span>}
          </div>
          {l1Result.text ? <pre class="verbatim">{l1Result.text}</pre> : <p class="empty-note">No memories matched.</p>}
        </div>
      )}
      {l1Result.state === "error" && <p class="error-note" style="margin-top: 1.1rem;">L1 search failed — {l1Result.message}</p>}
    </div>
  </section>
</Console>

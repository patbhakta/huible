# System-Caddy site block for the Huible app on the standby host (208.84.102.245).
#
# This is the cutover-time ingress config for runbook §3.4
# (docs/runbooks/vps-failover-to-standby.md). The standby's SYSTEM Caddy owns
# 80/443 (Kestra ingress depends on it), so the compose caddy service is
# excluded on this host (docker-compose.failover.yml) and this site block
# fronts the app instead. Upstream is the compose app's loopback binding
# (127.0.0.1:8000), NOT `app:8000` — the system Caddy is not on the huible-net
# docker network.
#
# HUIBLE_DOMAIN is supplied by the board/operator (ask-question interaction on
# HU-1501); Caddy reads it from its environment. Caddy auto-provisions TLS for
# the domain once DNS points at the standby (runbook §3.6).
#
# Install (see runbook §3.4 for the full gated procedure):
#   scp deploy/caddy-standby/huible-site.caddy root@<standby>:/etc/caddy/huible-site.caddy
#   # add to /etc/caddy/Caddyfile (top level):  import huible-site.caddy
#   caddy validate --config /etc/caddy/Caddyfile   # MUST pass before reload
#   systemctl reload caddy                         # reload, never restart

{$HUIBLE_DOMAIN:localhost} {
	# Health / liveness
	handle /api/v1/health {
		reverse_proxy 127.0.0.1:8000
	}

	# API v1
	handle /api/v1/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Static assets (Phase 3+ admin UI)
	handle /static/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Fallback — 404
	respond 404
}

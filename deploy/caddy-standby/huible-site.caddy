# System-Caddy site blocks for huible.com (HUI-1743 DNS landed 2026-08-25).
#
# Apex = public site (static placeholder until the in-house site build).
# api. = prod HUible API (docker huible-app on 127.0.0.1:8000).
#
# TLS: Cloudflare-proxied (orange). Full (strict) works because Caddy
# auto-provisions a Let's Encrypt cert for each name via TLS-ALPN-01 —
# requires the DNS record to exist FIRST (it does for the apex; api. pending
# Pat's A-record). If SSL mode is ever "Flexible", 525/redirect loops appear —
# runbook: always Full (strict).
#
# Install history: replaced the pre-stage block that bound {$HUIBLE_DOMAIN}. A
# systemd drop-in still exports HUIBLE_DOMAIN=huible.bhakta.us; it is now
# unused but harmless (kept for rollback context).

huible.com {
	# Health passthrough for uptime probes
	handle /api/v1/health {
		reverse_proxy 127.0.0.1:8000
	}

	# Public site
	handle {
		root * /var/www/huible
		encode gzip zstd
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

api.huible.com {
	# Prod HUible API (huible-app container, loopback binding)
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

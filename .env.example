# ─── Huible Environment Configuration ───────────────────────────────
# Copy to .env and fill in values. Never commit .env to version control.
#
# Variables marked [required] must be set. [optional] have sane defaults.

# ─── Application ───────────────────────────────────────────────────
HUIBLE_HOST=0.0.0.0                 # Bind address                      [optional] default: 0.0.0.0
HUIBLE_PORT=8000                    # Bind port                        [optional] default: 8000
HUIBLE_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR    [optional] default: INFO
HUIBLE_ENV=production               # development | staging | production [optional] default: production

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres              # Service name in Docker Compose    [optional] default: localhost
POSTGRES_PORT=5432                  #                                  [optional] default: 5432
POSTGRES_USER=huible                #                                  [required]
POSTGRES_PASSWORD=changeme         # Use a strong secret in production [required]
POSTGRES_DB=huible                  #                                  [required]
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Embedding Provider ───────────────────────────────────────────
# Phase 2+ — real provider for multi-vector embeddings.
EMBEDDING_PROVIDER=                 # openai | fake                     [optional] default: fake (Phase 1)
OPENAI_API_KEY=                     #                                  [required when EMBEDDING_PROVIDER=openai]
EMBEDDING_MODEL=text-embedding-3-small  #                             [optional] default: text-embedding-3-small

# ─── Tier 2 Advisory Models ──────────────────────────────────────
# Phase 2+ — Claude / GPT for gate adjudication and extraction.
# Advisory-only per docs/PERSONA_MODEL_STRATEGY.md: these NEVER speak as the
# persona voice. The generator (below) is the voice.
CLAUDE_API_KEY=                     # Anthropic API key                [optional] Phase 2+
OPENAI_ADVISORY_KEY=               # OpenAI key for advisory layer    [optional] Phase 2+

# ─── Persona Generator (the speaking voice) ─────────────────────
# Two-tier rule: the generator IS the persona. Strategy-preferred deployment is
# a SELF-HOSTED openweight uncensored 7B-24B model behind an OpenAI-compatible
# endpoint (vLLM / llama.cpp). Closed APIs are advisory-only and must not be the
# production voice unless explicitly authorized by the board hosting decision.
# Default is the deterministic, key-free mock so foundation work runs key-free.
GENERATOR_PROVIDER=mock             # mock | openai_compatible         [optional] default: mock
GENERATOR_BASE_URL=                 # e.g. http://vllm.local:8000/v1  [required when openai_compatible]
GENERATOR_MODEL=                    # e.g. an openweight 7B-24B model [required when openai_compatible]
GENERATOR_API_KEY=                  # bearer token for the endpoint   [optional] some self-hosted endpoints need none
# GENERATOR_MAX_TOKENS=512          # max response tokens             [optional] default: 512
# GENERATOR_TEMPERATURE=0.7         # sampling temperature            [optional] default: 0.7
# GENERATOR_REQUEST_TIMEOUT_S=60    # per-request timeout (seconds)   [optional] default: 60

# ─── LLM Client (runtime generation: OpenRouter / Gemini) ──────────────
# General-purpose hosted-LLM abstraction used by the chat endpoint and tests.
# Key-free default (fake) so the server boots and the suite runs without a key.
# Real providers raise a startup error if their key is absent — activation is a
# pure env-var change once the board approves a key/budget. Distinct from the
# generator above (which is the two-tier self-hosted persona voice).
LLM_PROVIDER=fake                   # fake | openrouter | gemini      [optional] default: fake
OPENROUTER_API_KEY=                 #                                 [required when LLM_PROVIDER=openrouter]
OPENROUTER_BASE_URL=                #                                 [optional] default: https://openrouter.ai/api/v1
OPENROUTER_MODEL=                   #                                 [optional] default: google/gemini-3-flash-preview
GEMINI_API_KEY=                     #                                 [required when LLM_PROVIDER=gemini]
GEMINI_BASE_URL=                    #                                 [optional] default: https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=                       #                                 [optional] default: gemini-2.5-flash
# LLM_MODEL=                        # global override for either real provider [optional]
# LLM_MAX_TOKENS=512                #                                 [optional] default: 512
# LLM_TEMPERATURE=0.7               #                                 [optional] default: 0.7
# LLM_REQUEST_TIMEOUT_S=60          # per-request timeout (seconds)   [optional] default: 60

# ─── API Authentication ─────────────────────────────────────────
API_KEYS=                           # Comma-separated persona-scoped keys [optional] Phase 2+

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty -> permissive (no credentials).
# Example: https://app.example.com,https://staging.example.com
CORS_ORIGINS=                       #                                  [optional] default: permissive

# ─── Reverse Proxy ────────────────────────────────────────────────
HUIBLE_DOMAIN=localhost             # Caddy uses this for HTTPS cert    [optional] default: localhost

# ─── Tailscale (optional) ─────────────────────────────────────────
TAILSCALE_ENABLED=false             # true to enable Tailscale funnel   [optional] default: false
TAILSCALE_FUNNEL_DOMAIN=            # e.g. huible.your-tailnet.ts.net   [optional]

# ─── Human-handoff (crisis escalation) queue — §7.4.1 ────────────
# Pre-real-user clinical gate (HU-1421 / HU-1407 §7.4 #1). When a G1 crisis
# signal fires on a persona-chat turn, the turn is routed into a staffed
# responder queue with a defined, monitored SLA and a fail-safe that degrades
# to the G1 non-persona safe response when no human is available (never drops,
# never the persona voice). The queue always runs so every escalation is
# audited (§10.1 invariant 5); the responder count is the operational lever.
HANDOFF_SLA_TARGET_SECONDS=300      # target for a responder to acknowledge       [optional] default: 300 (5 min)
HANDOFF_AVAILABLE_RESPONDERS=0      # simultaneous on-call responders              [optional] default: 0 (fail-safe degrade)
HANDOFF_RESPONDER_POOL=             # comma-separated staffed responder ids        [optional] default: synthetic ids

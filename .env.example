# ─── Huible Environment Configuration ───────────────────────────────
# Copy to .env and fill in values. Never commit .env to version control.
#
# Variables marked [required] must be set. [optional] have sane defaults.

# ─── Application ───────────────────────────────────────────────────
HUIBLE_HOST=0.0.0.0                 # Bind address                      [optional] default: 0.0.0.0
HUIBLE_PORT=8000                    # Bind port                        [optional] default: 8000
HUIBLE_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR    [optional] default: INFO
HUIBLE_ENV=production               # development | staging | production [optional] default: production

# ─── Database ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres              # Service name in Docker Compose    [optional] default: localhost
POSTGRES_PORT=5432                  #                                  [optional] default: 5432
POSTGRES_USER=huible                #                                  [required]
POSTGRES_PASSWORD=changeme         # Use a strong secret in production [required]
POSTGRES_DB=huible                  #                                  [required]
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Embedding Provider ───────────────────────────────────────────
# Phase 2+ — real provider for multi-vector embeddings.
# openai | fake                     [optional] default: fake (Phase 1)
EMBEDDING_PROVIDER=
#                                  [required when EMBEDDING_PROVIDER=openai]
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small  #                             [optional] default: text-embedding-3-small

# ─── Tier 2 Advisory Models ──────────────────────────────────────
# Phase 2+ — Claude / GPT for gate adjudication and extraction.
# Advisory-only per docs/PERSONA_MODEL_STRATEGY.md: these NEVER speak as the
# persona voice. The generator (below) is the voice.
# Anthropic API key                [optional] Phase 2+
CLAUDE_API_KEY=
# OpenAI key for advisory layer    [optional] Phase 2+
OPENAI_ADVISORY_KEY=

# ─── Persona Generator (the speaking voice) ─────────────────────
# Two-tier rule: the generator IS the persona. Strategy-preferred deployment is
# a SELF-HOSTED openweight uncensored 7B-24B model behind an OpenAI-compatible
# endpoint (vLLM / llama.cpp). Closed APIs are advisory-only and must not be the
# production voice unless explicitly authorized by the board hosting decision.
# Default is the deterministic, key-free mock so foundation work runs key-free.
GENERATOR_PROVIDER=mock             # mock | openai_compatible         [optional] default: mock
# e.g. http://vllm.local:8000/v1  [required when openai_compatible]
GENERATOR_BASE_URL=
# e.g. an openweight 7B-24B model [required when openai_compatible]
GENERATOR_MODEL=
# bearer token for the endpoint   [optional] some self-hosted endpoints need none
GENERATOR_API_KEY=
# GENERATOR_MAX_TOKENS=512          # max response tokens             [optional] default: 512
# GENERATOR_TEMPERATURE=0.7         # sampling temperature            [optional] default: 0.7
# GENERATOR_REQUEST_TIMEOUT_S=60    # per-request timeout (seconds)   [optional] default: 60

# ─── LLM Client (runtime generation: OpenRouter / Gemini) ──────────────
# General-purpose hosted-LLM abstraction used by the chat endpoint and tests.
# Key-free default (fake) so the server boots and the suite runs without a key.
# Real providers raise a startup error if their key is absent — activation is a
# pure env-var change once the board approves a key/budget. Distinct from the
# generator above (which is the two-tier self-hosted persona voice).
LLM_PROVIDER=fake                   # fake | openrouter | gemini      [optional] default: fake
#                                 [required when LLM_PROVIDER=openrouter]
OPENROUTER_API_KEY=
#                                 [optional] default: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
#                                 [optional] default: google/gemini-3-flash-preview
OPENROUTER_MODEL=
#                                 [required when LLM_PROVIDER=gemini]
GEMINI_API_KEY=
#                                 [optional] default: https://generativelanguage.googleapis.com/v1beta
GEMINI_BASE_URL=
#                                 [optional] default: gemini-2.5-flash
GEMINI_MODEL=
# LLM_MODEL=                        # global override for either real provider [optional]
# LLM_MAX_TOKENS=512                #                                 [optional] default: 512
# LLM_TEMPERATURE=0.7               #                                 [optional] default: 0.7
# LLM_REQUEST_TIMEOUT_S=60          # per-request timeout (seconds)   [optional] default: 60

# ─── API Authentication ─────────────────────────────────────────
# Comma-separated persona-scoped keys [optional] Phase 2+
API_KEYS=

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty -> permissive (no credentials).
# Example: https://app.example.com,https://staging.example.com
#                                  [optional] default: permissive
CORS_ORIGINS=

# ─── Reverse Proxy ────────────────────────────────────────────────
HUIBLE_DOMAIN=localhost             # Caddy uses this for HTTPS cert    [optional] default: localhost

# ─── Tailscale (optional) ─────────────────────────────────────────
TAILSCALE_ENABLED=false             # true to enable Tailscale funnel   [optional] default: false
# e.g. huible.your-tailnet.ts.net   [optional]
TAILSCALE_FUNNEL_DOMAIN=

# ─── Human-handoff (crisis escalation) queue — §7.4.1 ────────────
# Pre-real-user clinical gate (HU-1421 / HU-1407 §7.4 #1). When a G1 crisis
# signal fires on a persona-chat turn, the turn is routed into a staffed
# responder queue with a defined, monitored SLA and a fail-safe that degrades
# to the G1 non-persona safe response when no human is available (never drops,
# never the persona voice). The queue always runs so every escalation is
# audited (§10.1 invariant 5); the responder count is the operational lever.
HANDOFF_SLA_TARGET_SECONDS=300      # target for a responder to acknowledge       [optional] default: 300 (5 min)
HANDOFF_AVAILABLE_RESPONDERS=0      # simultaneous on-call responders              [optional] default: 0 (fail-safe degrade)
# comma-separated staffed responder ids        [optional] default: synthetic ids
HANDOFF_RESPONDER_POOL=
# Coverage-hours gate (HU-1428 AC #2): even with responders staffed, escalations
# outside the window degrade to the G1 safe response (never a false "person
# joining"). Default 24/7; switch to `hours` once the §7.4.1 coverage-hours
# decision (AC #1) records the on-call schedule.
HANDOFF_COVERAGE_MODE=always        # always (24/7) or hours (bounded window)      [optional] default: always
HANDOFF_COVERAGE_TZ=UTC             # IANA timezone for the coverage window         [optional] default: UTC
HANDOFF_COVERAGE_OPEN_HOUR=0        # hour-of-day coverage opens, inclusive (0-23) [optional] default: 0
HANDOFF_COVERAGE_CLOSE_HOUR=24      # hour-of-day coverage ends, exclusive (1-24)  [optional] default: 24
# On-call paging transport (Stage 0.4 wire, HU-1450). The alert→on-call paging
# link deferred from HU-1446: an enqueued crisis ticket pages a real person once
# the roster is named (HU-1447). Key-free default (log) emits a structured
# handoff.page CRITICAL log line the operator scrapes/alerts on; webhook POSTs
# to a Slack incoming webhook / PagerDuty Events API v2 URL (falling back to
# the log line when the URL is empty so credentials land at deploy time).
HANDOFF_PAGER_PROVIDER=log          # log | webhook                                 [optional] default: log (key-free)
# Slack/PagerDuty incoming webhook URL          [optional] default: "" (log fallback)
HANDOFF_PAGER_WEBHOOK_URL=
#
# ── Stage 0.4a Sev-1 paging channel (HU-1451) ─────────────────────────────
# The four §3 Sev-1 triggers (crisis enqueue + ack-SLA miss + un-grounded
# claim leak + degraded net + consent bypass) page a REAL human channel, not
# merely a log line. Defaults stay empty so the key-free LoggingPager remains
# the honest pre-deploy posture — flip these at deploy time once the on-call
# roster contacts + provider credentials are provisioned.
#
# On-call contact map: JSON seat_id -> {"phone": "<E.164>", "email": "<addr>"}.
# Seats are the [HU-1447] §1 roster ids. Resolve primary/secondary per window.
# e.g. {"clinical-advisor":{"phone":"+1...","email":"..."}}  [optional] default: "" (log fallback)
HANDOFF_ONCALL_CONTACTS=
# Canary T+0 clock — the ISO-8601 timestamp of the first real grieving-user
# turn. The 4×12h rotation (W1: clinical-advisor/ceo, W2: huible-pm/
# clinical-advisor, W3: huible-tech-lead/huible-pm, W4: clinical-advisor/
# huible-tech-lead) is anchored here. Empty → roster unconfigured → log fallback.
# e.g. 2026-08-12T09:00:00-05:00               [optional] default: "" (log fallback)
HANDOFF_CANARY_START_TS=
# Telnyx SMS outbound (the inbound side already speaks the Telnyx webhook).
# Empty key/from → SMS channel omitted. Phone numbers in E.164.
# Telnyx Messaging API key                      [optional] default: "" (SMS omitted)
TELNYX_API_KEY=
# Telnyx sender number (E.164)                  [optional] default: "" (SMS omitted)
TELNYX_FROM=
# TELNYX_API_BASE_URL=https://api.telnyx.com/v2                                     [optional] default: https://api.telnyx.com/v2
# Email (SMTP relay) outbound. Empty host → email channel omitted.
# e.g. smtp.example.com                         [optional] default: "" (email omitted)
HANDOFF_PAGER_SMTP_HOST=
# HANDOFF_PAGER_SMTP_PORT=587        #                                              [optional] default: 587
#                                              [optional] default: ""
HANDOFF_PAGER_SMTP_USER=
#                                              [optional] default: ""
HANDOFF_PAGER_SMTP_PASSWORD=
# e.g. oncall@huible.example                    [optional] default: "" (falls back to SMTP_USER)
HANDOFF_PAGER_EMAIL_FROM=
#
# ── Stage 1 canary on-call config (HU-1436 §3 / HU-1447 roster) ──
# Founder-staffed 4×12h roster (PM / Tech Lead / Clinical Advisor / CEO). Flip
# these to make the roster *live*: the gauge reads 1, every enqueued crisis
# ticket pages the on-call, and an unacked ticket past the 15-min ack SLA is
# re-paged at Sev-1. Defaults stay at the fail-safe (0 responders) so an
# unconfigured deploy never falsely pages or promises a responder.
#   HANDOFF_AVAILABLE_RESPONDERS=4
#   HANDOFF_RESPONDER_POOL=huible-pm,huible-tech-lead,clinical-advisor,ceo
#   HANDOFF_SLA_TARGET_SECONDS=900
#   HANDOFF_COVERAGE_MODE=always

# ─── Real-user persona-chat traffic switches ─────────────────────
# Two composing controls on POST /api/v1/chat/{persona_id}. Internal/synthetic
# traffic (X-Huible-Traffic-Class: internal) is unaffected by BOTH — the test
# suite and probes keep running when either is off. Unknown/blank values
# default to the safe (refusing) direction.
#
# ── Stage 0.7 HARD kill switch (HU-1462, MANDATORY) — the PRIMARY rollback
#    path (launch plan §4.2). One env flip to off refuses EVERY real-user turn
#    with HTTP 503 SERVICE_DISABLED, independent of key-revocation propagation.
#    Crisis/handoff audit still records (§10.1 invariant 5). The rollback
#    dry-run (plan §4.3) is reproducible via scripts/verify_kill_switch_rollback.py.
#    on/true/1/yes (case-insensitive) permit real-user traffic; anything else
#    (default off) refuses it. Settings are process-cached — a flip requires a
#    container restart.
PERSONA_CHAT_REAL_USER_TRAFFIC=off    # on | off (boolean) — hard emergency brake  [optional] default: off (safe)
#
# ── Stage 0.1 ramp gate (HU-1444) — the staged-exposure lever. Only reached
#    when the hard kill switch above is ON. off refuses real-user turns with a
#    warm non-persona response (HTTP 200, 988 surfaced); canary allows only the
#    personas in PERSONA_CHAT_CANARY_PERSONAS; open allows all.
PERSONA_CHAT_REAL_USER_MODE=off       # off | canary | open — ramp state machine   [optional] default: off (safe)
# PERSONA_CHAT_CANARY_PERSONAS=<uuid>,<uuid>  # personas allowed under canary     [optional] default: "" (none)
